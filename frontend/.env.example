# =============================================================================
# MDL web app configuration.   Copy to `.env` (cp .env.example .env).
# Everything prefixed VITE_ is shipped to the browser: PUBLIC values only, never secrets.
# Guide: docs/09-local-setup.md
# =============================================================================

# Base URL of the API (no trailing slash). The backend listens on port 4000 by default.
# Production example: https://api.your-domain.example
VITE_API_BASE_URL=http://localhost:4000
