# =============================================================================
# MDL web app configuration.   Copy to `.env` (cp .env.example .env).
# Everything prefixed VITE_ is shipped to the browser: PUBLIC values only, never secrets.
# Guide: docs/09-local-setup.md
# =============================================================================

# Base URL of the API (no trailing slash). The backend listens on port 4000 by default.
# Production example: https://api.your-domain.example
VITE_API_BASE_URL=http://localhost:4000

# Set to "true" to ENFORCE the Content-Security-Policy instead of only reporting violations.
# Do this only after reviewing a week of reports from the real domain (docs/10-sprint-backlog.md, C4).
# VITE_CSP_ENFORCE=false

# --- Vercel (production and preview) ----------------------------------------
# Build-time settings (Vercel: Project > Settings > Environment Variables, tick Production AND Preview):
#   API_PROXY_TARGET=https://mindsdigitallegacyserver.onrender.com
#       The website forwards /api to this address, so the browser only talks to the website itself and the
#       sign-in cookie works in every browser. https only, no trailing slash, no path.
#   Leave VITE_API_BASE_URL UNSET on Vercel. (Setting both stops the build on purpose.)
# Local development keeps VITE_API_BASE_URL=http://localhost:4000 (above) and needs no API_PROXY_TARGET.
# The build prints its mode and API setup first: "[check-env] mode: vercel production; API: proxied to ...".
# API_PROXY_TARGET=
