# =============================================================================
# MDL API configuration.   Copy to `.env` (cp .env.example .env) and edit.
# `.env` is git-ignored: NEVER commit it, never paste real secrets into chat or tickets.
# In staging/production inject these from the platform's secret manager instead of a file.
# Every value below is a placeholder, not a secret. Lines starting with `#` are optional.
# Guide: docs/09-local-setup.md
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# development | test | production. Production turns on strict checks (see "Production only").
NODE_ENV=development
# Interface to listen on. 127.0.0.1 = this machine only (safe default).
HOST=127.0.0.1
PORT=4000
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# Human-readable logs for local development only. Never set to true in production.
LOG_PRETTY=true

# --- Database ----------------------------------------------------------------
# MongoDB connection string. Options for local work:
#   1) Docker (backend/docker-compose.yml), matches MONGO_USER / MONGO_PASSWORD below:
#      mongodb://mdl:change-me-locally@127.0.0.1:27017/mdl?authSource=admin
#   2) MongoDB installed on your machine, no auth:
#      mongodb://127.0.0.1:27017/mdl
#   3) MongoDB Atlas (free tier is fine for testing, NOT for real learner data):
#      mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/mdl
# Leave it unset to start the API without a database (/api/v1/ready then answers 503).
# Using `npm run dev:memory` needs no database at all.
# Production personal data must be stored in Rwanda (docs/adr/0003).
MONGODB_URI=mongodb://mdl:change-me-locally@127.0.0.1:27017/mdl?authSource=admin

# --- Browser access ----------------------------------------------------------
# Browser origins allowed to call this API. Exact origins only: no wildcard, no trailing slash,
# https only in production. The web app runs on port 3000 in development.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Public URL of the web app. Used to build the links inside emails. https is required in production.
WEB_BASE_URL=http://localhost:3000

# --- Reverse proxy -----------------------------------------------------------
# How many proxies sit in front of the API (0 = none, e.g. local). Wrong values let people
# forge their IP address and dodge per-IP rate limits. Set correctly in production.
TRUST_PROXY=0

# --- Limits ------------------------------------------------------------------
# Maximum request body size in KB (1-256).
BODY_LIMIT_KB=16
# Requests per minute per IP, all endpoints.
RATE_LIMIT_GENERAL_PER_MINUTE=120
# Contact/lead form submissions per hour per IP.
RATE_LIMIT_LEADS_PER_HOUR=20
# Sign-in, register and password-reset attempts per 15 minutes per IP.
# Raise it if you hit "too many requests" while testing many accounts.
RATE_LIMIT_AUTH_PER_15MIN=20
# Learning actions (progress, enrol) per minute per IP.
RATE_LIMIT_LEARNING_PER_MINUTE=90
# Days to keep contact leads before deletion (30-3650).
LEAD_RETENTION_DAYS=730
# Days between an account deletion request and permanent removal of its data (confirm with counsel).
ACCOUNT_PURGE_GRACE_DAYS=30
# Minutes between in-process purge runs. 0 = off (then run `npm run purge:accounts` from cron).
ACCOUNT_PURGE_INTERVAL_MINUTES=60
# How many interns one supervisor may guide at once (1-10). Caps the slots a posting can offer.
INTERNSHIP_MAX_PER_SUPERVISOR=3
# Per-client cap on browser CSP violation reports.
RATE_LIMIT_CSP_REPORTS_PER_MINUTE=30

# --- Staff two-step verification --------------------------------------------
# Encrypts staff authenticator secrets at rest (AES-256-GCM). 32+ characters.
# Generate:  openssl rand -base64 32
# REQUIRED in production. In development a built-in insecure key is used when unset.
# Losing this key means every staff member must reset two-step verification.
# TOTP_ENCRYPTION_KEY=

# --- Email -------------------------------------------------------------------
# log    = nothing is sent; verification/reset links are printed in the API console (development).
# brevo  = send through Brevo      resend = send through Resend   (needs the two values below)
# See docs/06-third-party-providers.md. The sending domain needs SPF, DKIM and DMARC records.
EMAIL_PROVIDER=log
# EMAIL_API_KEY=
# EMAIL_FROM=no-reply@your-domain.example
EMAIL_FROM_NAME=Minds Digital Legacy

# --- Password safety ---------------------------------------------------------
# Check new passwords against the Have I Been Pwned range API (only a 5-character hash prefix is
# sent, never the password). Needs internet access. Set to false when working offline.
PASSWORD_BREACH_CHECK=true

# --- Production only (enforced when NODE_ENV=production) ----------------------
# Required: MONGODB_URI, TOTP_ENCRYPTION_KEY, CORS_ORIGINS (https), WEB_BASE_URL (https),
# and EMAIL_API_KEY + EMAIL_FROM when EMAIL_PROVIDER is not `log`. The server refuses to start otherwise.

# --- Used only by backend/docker-compose.yml (local MongoDB) -----------------
# Pick your own values, letters and digits only. Keep MONGODB_URI above in sync.
MONGO_USER=mdl
MONGO_PASSWORD=change-me-locally
