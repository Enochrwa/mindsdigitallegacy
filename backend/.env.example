# Copy to `.env` for local development. NEVER commit `.env` (it is git-ignored).
# In staging and production, inject these from the platform's secret manager instead of a file.
# Values below are non-secret placeholders only.

NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
# Human-readable logs for local development only (needs dev dependencies). Never set in production.
LOG_PRETTY=true

# Local development database. Production personal data must be stored in Rwanda (ADR-0003).
# Leave unset to run without a database (/api/v1/ready then reports 503).
MONGODB_URI=mongodb://mdl:change-me-locally@127.0.0.1:27017/mdl?authSource=admin

# Browser origins allowed to call this API. Exact origins only, no wildcard, no trailing slash.
# Production requires https. Add your frontend dev URL here.
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:5173

# Public URL of the web app (used in email links). https is required in production.
WEB_BASE_URL=http://localhost:8080

# Number of reverse proxies in front of the API (0 = none).
# Set this correctly in production or per-IP rate limits can be bypassed with a forged header.
TRUST_PROXY=0

BODY_LIMIT_KB=16
RATE_LIMIT_GENERAL_PER_MINUTE=120
RATE_LIMIT_LEADS_PER_HOUR=20
RATE_LIMIT_AUTH_PER_15MIN=20
LEAD_RETENTION_DAYS=730

# --- Only used by docker-compose.yml (local MongoDB). Generate your own, letters and digits only.
MONGO_USER=mdl
MONGO_PASSWORD=change-me-locally
